# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# Which model drives the agent. Pick any current Claude model.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_ITERATIONS=40

# Safety
SCOPE_ENFORCED=true

# Browser
HEADLESS=true

API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
